# Copy to ~/.config/rea/env and set paths for this host. This is sourced as Bash.
# A full 64-bit JDK 21+ and Ghidra 12.1.x are required for native analysis.
# export GHIDRA_INSTALL_DIR="$HOME/Extras/ghidra_12.1.4"
# export JAVA_HOME="/absolute/path/to/jdk"
# Optional GUI launcher; IDA Free cannot serve REA's IDA MCP provider.
# export IDA_INSTALL_DIR="$HOME/ida-free-9.4"
# The Android engine defaults to ~/.local/share/rea/engines/ in rea-local.
