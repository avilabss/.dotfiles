{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-5.6-terra",
  "default_agent": "architect",
  "subagent_depth": 2,
  "instructions": [
    "~/.config/opencode/instructions/tool-selection.md"
  ],
  "agent": {
    "code-reviewer-1": {
      "description": "Reviews code for best practices and potential issues.",
      "mode": "subagent",
      "model": "openai/gpt-6-astra",
      "variant": "high",
      "textVerbosity": "low",
      "prompt": "{file:./prompts/code-reviewer.md}",
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "task": "deny"
      }
    },
    "code-reviewer-2": {
      "description": "Reviews code for best practices and potential issues.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "textVerbosity": "low",
      "prompt": "{file:./prompts/code-reviewer.md}",
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "task": "deny"
      }
    }
  },
  "enabled_providers": [
    "openai"
  ],
  "provider": {
    "openai": {
      "models": {
        "gpt-6-astra": {
          "options": {
            "reasoningEffort": "high"
          }
        },
        "gpt-5.6-terra": {
          "options": {
            "reasoningEffort": "medium"
          }
        }
      }
    }
  },
  "autoupdate": true,
  "share": "disabled",
  "snapshot": false,
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 20000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      "target/**",
      ".venv/**",
      "__pycache__/**",
      ".next/**",
      "coverage/**"
    ]
  },
  "server": {
    "port": 4096
  },
  "mcp": {
    "freecad": {
      "type": "local",
      "command": [
        "/home/avi/.local/bin/uv",
        "--directory",
        "/home/avi/.var/app/org.freecad.FreeCAD/data/FreeCAD/v1-1/Mod/freecad-mcp",
        "run",
        "--locked",
        "--no-dev",
        "freecad-mcp"
      ],
      "enabled": true
    }
  }
}
