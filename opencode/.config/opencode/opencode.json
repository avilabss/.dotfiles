{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-astra",
  "default_agent": "architect",
  "permissions": [
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "experimental": {
    "subagent_depth": 2
  },
  "agent": {
    "code-reviewer-1": {
      "description": "Reviews code for best practices and potential issues.",
      "mode": "subagent",
      "model": "openai/gpt-6-astra",
      "variant": "high",
      "textVerbosity": "low",
      "prompt": "{file:./prompts/code-reviewer.md}",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "deny"
      }
    },
    "code-reviewer-2": {
      "description": "Reviews code for best practices and potential issues.",
      "mode": "subagent",
      "model": "claude-code/claude-fable-5-1[1m]",
      "variant": "high",
      "textVerbosity": "low",
      "prompt": "{file:./prompts/code-reviewer.md}",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "deny"
      }
    }
  },
  "agents": {
    "title": {
      "model": "openai/gpt-6-luna#low"
    }
  },
  "enabled_providers": [
    "openai",
    "claude-code"
  ],
  "provider": {
    "openai": {
      "models": {
        "gpt-6-astra": {
          "options": {
            "reasoningEffort": "high"
          }
        },
        "gpt-5.6-terra": {
          "options": {
            "reasoningEffort": "medium"
          }
        }
      }
    }
  },
  "autoupdate": true,
  "share": "disabled",
  "snapshot": false,
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 20000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      "target/**",
      ".venv/**",
      "__pycache__/**",
      ".next/**",
      "coverage/**"
    ]
  },
  "server": {
    "port": 4096
  },
  "mcp": {
    "freecad": {
      "type": "local",
      "command": [
        "/home/avi/.local/bin/uv",
        "--directory",
        "/home/avi/.var/app/org.freecad.FreeCAD/data/FreeCAD/v1-1/Mod/freecad-mcp",
        "run",
        "--locked",
        "--no-dev",
        "freecad-mcp"
      ],
      "enabled": true
    }
  },
  "plugins": [
    "@openchamber/opencode-claude@1.3.2"
  ],
  "websearch": {
    "provider": "firecrawl"
  }
}
