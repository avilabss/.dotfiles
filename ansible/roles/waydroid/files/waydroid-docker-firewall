#!/bin/sh

set -eu

outbound_rule="-i waydroid0 -j ACCEPT"
return_rule="-o waydroid0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT"

case "${1:-apply}" in
    apply)
        if ! iptables -S DOCKER-USER >/dev/null 2>&1; then
            exit 0
        fi

        # shellcheck disable=SC2086
        iptables -C DOCKER-USER $outbound_rule 2>/dev/null ||
            iptables -I DOCKER-USER 1 $outbound_rule

        # shellcheck disable=SC2086
        iptables -C DOCKER-USER $return_rule 2>/dev/null ||
            iptables -I DOCKER-USER 2 $return_rule
        ;;
    remove)
        if ! iptables -S DOCKER-USER >/dev/null 2>&1; then
            exit 0
        fi

        # Remove every matching copy in case rules were also added manually.
        # shellcheck disable=SC2086
        while iptables -C DOCKER-USER $outbound_rule 2>/dev/null; do
            # shellcheck disable=SC2086
            iptables -D DOCKER-USER $outbound_rule
        done

        # shellcheck disable=SC2086
        while iptables -C DOCKER-USER $return_rule 2>/dev/null; do
            # shellcheck disable=SC2086
            iptables -D DOCKER-USER $return_rule
        done
        ;;
    *)
        echo "Usage: $0 [apply|remove]" >&2
        exit 2
        ;;
esac
